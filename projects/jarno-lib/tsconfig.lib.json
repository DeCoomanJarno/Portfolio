{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "target": "ES2020",
    "module": "ESNext",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,  
    "inlineSources": true,
    "strict": true,
    "skipLibCheck": true,
    "types": []
  },
  "angularCompilerOptions": {
    "enableIvy": true
  },
  "exclude": ["src/test.ts", "**/*.spec.ts"],
  "include": ["src/**/*.ts"]
}
